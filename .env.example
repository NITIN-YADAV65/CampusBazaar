# CampusBazaar Supabase Environment Variables
# Replace these with your actual Supabase Project Settings -> API credentials

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Custom base URL for authentication email redirects (defaults to production URL https://campusbazaar-gilt.vercel.app when deployed)
# VITE_APP_URL=https://campusbazaar-gilt.vercel.app

# VAPID Public Key for Web Push Notifications (Safe for browser/frontend)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
